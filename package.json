{
  "name": "blush-css",
  "version": "0.2.0",
  "description": "A reset with superpowers. A classless CSS framework built on Tailwind CSS v4: pretty & semantic by default, classes only add layout and tone.",
  "keywords": [
    "css",
    "css-framework",
    "classless",
    "semantic-html",
    "tailwindcss",
    "tailwind-v4",
    "design-tokens",
    "themes",
    "aria",
    "accessibility"
  ],
  "homepage": "https://forwalk-org.github.io/blush-css/",
  "bugs": {
    "url": "https://github.com/forwalk-org/blush-css/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Maurizio Melani",
    "email": "maurizio@forwalk.org",
    "url": "https://forwalk.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forwalk-org/blush-css.git"
  },
  "private": true,
  "scripts": {
    "build": "tailwindcss -i src/blush.css -o dist/blush.css --minify",
    "watch:css": "tailwindcss -i src/blush.css -o dist/blush.css --watch --map",
    "serve": "browser-sync start --server --startPath 'demo/blush-demo.html' --files \"dist/*.css, demo/**/*.html\" --no-notify",
    "dev": "npm-run-all --parallel watch:css serve"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "browser-sync": "^3.0.3",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.0"
  }
}
